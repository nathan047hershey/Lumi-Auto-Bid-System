# Example environment template — commit this; never commit .env itself.
# Copy to .env and fill in real values.

# Server
PORT=9017

# JWT signing secret
JWT_SECRET=change-me-to-a-long-random-string

# DeepSeek API key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Minimax API keys (used when admin selects the "MiniMax" provider in Settings).
# Prefer putting Key 2 in server/local.env (gitignored) — see local.env.example.
# MINIMAX_PREFER_ENV=1 makes env keys win over Admin Settings paste.
# MINIMAX_KEY_SLOT=2 makes Key 2 the default.
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_API_KEY_2=your-second-minimax-api-key

# Optional Groq (many keys — prefer Admin → Settings paste; or GROQ_API_KEY_1…N)
# GROQ_API_KEY=# MINIMAX_PREFER_ENV=1
# MINIMAX_KEY_SLOT=2

# -----------------------------------------------------------------------------
# Local LLM (optional). Written autofill answers default to MiniMax (same as CV).
# Fixed fields (gender, disability, …) always come from the saved profile — never LLM.
# Set ANSWERS_USE_LOCAL=1 to force Ollama for written answers only.
# -----------------------------------------------------------------------------
# LOCAL_LLM_ENABLED=true
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=llama3.2
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_TIMEOUT_MS=120000
# ANSWERS_USE_LOCAL=1

# -----------------------------------------------------------------------------
# Job Links scraper
# -----------------------------------------------------------------------------
#
# URL of the Python Playwright service. The Node cron polls the
# `job_links` table and posts each pending URL to this service for
# fetching. Default works for the in-repo `services/scraper/python_service.py`.
JOB_LINKS_SCRAPER_URL=http://127.0.0.1:8765

# Provider selector:
#   auto   try the Python service first; fall back to the in-process
#          puppeteer/cheerio scraper if it isn't reachable
#   python require the Python service; fall back to in-process if
#          unreachable (so scraping doesn't stall)
#   node   skip the Python service entirely
JOB_LINKS_SCRAPER_PROVIDER=auto

# LinkedIn session cookie (li_at) for the Python service. WITHOUT
# this, LinkedIn returns its sign-in wall for every job page and
# `job_description` will be empty / "Not Found".
#
# To extract: in a real browser where you're logged into LinkedIn,
# open DevTools → Application → Cookies → www.linkedin.com → copy
# the value of `li_at`. The cookie typically has a multi-month
# lifetime.
LINKEDIN_LI_AT=

# (Optional) tune the polling cadence. Defaults are sane for a
# single-team workload; tighten only if LinkedIn isn't responding.
# JOB_LINKS_POLL_MS=30000
# JOB_LINKS_SCRAPE_MS=500
# JOB_LINKS_BATCH=60

# -----------------------------------------------------------------------------
# Microsoft Graph — Outlook / Hotmail / Microsoft 365 via Graph API
# -----------------------------------------------------------------------------
# 1. Azure Portal or Entra → App registrations → New registration
#    - Supported accounts:
#      • Personal Microsoft accounts only (default, OUTLOOK_AUTH_TENANT not set)
#      • Any organization (set OUTLOOK_AUTH_TENANT=common)
#      • Specific tenant (set OUTLOOK_AUTH_TENANT=your-tenant-id)
#    - Authentication → Allow public client flows = Yes (device code)
#    - API permissions (delegated): User.Read, Mail.Read, offline_access
# 2. Paste Application (client) ID below, restart API
# 3. Auto Bidder → Advanced → Microsoft Graph → Add mailbox
#
# OTP works without a tunnel (Graph sync on demand + auto-poll).
# Optional instant push: cloudflared tunnel + MAIL_WEBHOOK_PUBLIC_BASE=https://...
#
# TENANT OPTIONS:
#   - Not set or "consumers" : Personal Microsoft accounts (outlook.com, hotmail.com)
#   - "common"              : Multi-tenant (any organization's accounts)
#   - "{tenant-id}"         : Specific organization (e.g., "mycompany.onmicrosoft.com")
OUTLOOK_CLIENT_ID=
# OUTLOOK_AUTH_TENANT=consumers   # or "common" for multi-tenant, or your tenant ID
# OUTLOOK_CLIENT_SECRET=   # only if app is confidential (usually not needed for device code)
# MAIL_WEBHOOK_PUBLIC_BASE=https://your-tunnel.trycloudflare.com
# OUTLOOK_POLL_ENABLED=0
# OUTLOOK_ON_DEMAND_GRAPH=1
# OUTLOOK_GRAPH_AUTO_POLL=1
# OUTLOOK_SYNC_MS=300000
