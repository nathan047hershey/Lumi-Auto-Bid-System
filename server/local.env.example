# Local secrets — NOT committed. Copied from local.env.example.
# Loaded after .env and overrides it. Restart the API after changes.

# Persistent data (sqlite, resumes, bidder) — portable with the repo root.
# Default if unset: <repo-root>/database  (sibling of server/, client/)
# Relative path — do not put a fixed folder name or drive letter here:
LUMI_DATA_ROOT=database
# Absolute only if data must live outside the repo:
# LUMI_DATA_ROOT=D:\elsewhere\lumi-data

# Use MiniMax Key 2 from this file (not Admin Settings paste)
MINIMAX_PREFER_ENV=1
MINIMAX_KEY_SLOT=2

# Paste your MiniMax Key 2 here (no quotes)
MINIMAX_API_KEY_2=paste-your-minimax-key-2-here

# Optional Groq keys (written by Admin → Settings → Add Groq key)
# CV + normal answers: MiniMax. Groq checks weak drafts, rescues empties, checkouts form before submit.
# ANSWERS_GROQ_CHECK=0           # disable answer QA pass
# APPLICATION_CHECKOUT_GROQ=0    # disable pre-submit application checkout
# GROQ_API_KEY=
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# Force answers provider: ANSWERS_PROVIDER=minimax|groq|deepseek

# Optional: show remaining chat quota on Analyze (1 successful API call = 1 chat)
# MINIMAX_CHAT_LIMIT_DAY=100
# MINIMAX_CHAT_LIMIT_5H=50
# MINIMAX_CHAT_LIMIT_WEEK=500

# -----------------------------------------------------------------------------
# Gemini — scrape rescue ONLY (not MiniMax CV/answers)
# Keys 1–3: Job Links when ATS scrape fails / JD empty (after link check)
# Key 4: RESERVED for other features — never used for scraping
# Restart API after editing. VPN (US) may be required in some regions.
# Set JOB_LINKS_SKIP_GEMINI=1 to never call Gemini (ATS-only scrape).
# JOB_LINKS_SCRAPER_PROVIDER=auto|node|python  (default auto)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_SCRAPE_MODEL=gemini-3.6-flash
# JOB_LINKS_SKIP_GEMINI=1
# JOB_LINKS_SCRAPER_PROVIDER=node
