# Local secrets — NOT committed. Copied from local.env.example.
# Loaded after .env and overrides it. Restart the API after changes.

# Persistent data (sqlite, resumes, bidder) — portable with the repo root.
# Default if unset: <repo-root>/database  (sibling of server/, client/)
# Relative path — do not put a fixed folder name or drive letter here:
LUMI_DATA_ROOT=database
# Absolute only if data must live outside the repo:
# LUMI_DATA_ROOT=D:\elsewhere\lumi-data

# Use MiniMax Key 2 from this file (not Admin Settings paste)
MINIMAX_PREFER_ENV=1
MINIMAX_KEY_SLOT=2

# Paste your MiniMax Key 2 here (no quotes)
MINIMAX_API_KEY_2=paste-your-minimax-key-2-here

# Optional Groq keys (written by Admin → Settings → Add Groq key)
# Autofill / form answers: Groq by default (rotates keys). CV generation stays MiniMax.
# ANSWERS_PROVIDER=minimax       # opt back into MiniMax for answers
# ANSWERS_GROQ_CHECK=0           # disable answer QA pass (MiniMax path only)
# APPLICATION_CHECKOUT_GROQ=0    # disable pre-submit application checkout
# GROQ_API_KEY=
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=

# Optional: Groq free-tier analytics caps (Analyze → Usage).
# Defaults match openai/gpt-oss-20b (1k RPD / 200k TPD).
# GROQ_RPD_LIMIT=1000
# GROQ_TPD_LIMIT=200000

# Optional: show remaining MiniMax chat quota on Analyze (1 successful API call = 1 chat)
# MINIMAX_CHAT_LIMIT_DAY=100
# MINIMAX_CHAT_LIMIT_5H=50
# MINIMAX_CHAT_LIMIT_WEEK=500

# -----------------------------------------------------------------------------
# Gemini — scrape rescue ONLY (not MiniMax CV/answers)
# Keys 1–3: Job Links when ATS scrape fails / JD empty (after link check)
# Key 4: RESERVED for other features — never used for scraping
# Restart API after editing. VPN (US) may be required in some regions.
# Set JOB_LINKS_SKIP_GEMINI=1 to never call Gemini (ATS-only scrape).
# JOB_LINKS_SCRAPER_PROVIDER=auto|node|python  (default auto)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_SCRAPE_MODEL=gemini-3.6-flash
# JOB_LINKS_SKIP_GEMINI=1
# JOB_LINKS_SCRAPER_PROVIDER=node

# -----------------------------------------------------------------------------
# Microsoft Graph — Outlook / Hotmail / Microsoft 365 via Graph API
# Supported account types controlled by OUTLOOK_AUTH_TENANT:

#   - Not set or "consumers" : Personal Microsoft accounts (outlook.com, hotmail.com)
#   - "common"              : Multi-tenant (any organization's accounts)
#   - "{tenant-id}"         : Specific organization (e.g., "mycompany.onmicrosoft.com")
# Azure Portal/Entra App registration + Allow public client flows + Mail.Read
# Paste client ID, restart API, Auto Bidder → Microsoft Graph → Add mailbox
OUTLOOK_CLIENT_ID=
# OUTLOOK_AUTH_TENANT=consumers   # or "common" for multi-tenant, or your tenant ID
# MAIL_WEBHOOK_PUBLIC_BASE=https://your-tunnel.trycloudflare.com
# OUTLOOK_ON_DEMAND_GRAPH=1
# OUTLOOK_GRAPH_AUTO_POLL=1

# -----------------------------------------------------------------------------
# Free Gmail receive (IMAP App Password) — no paid inbound API / Pub/Sub
# Prefer Auto Bidder → Advanced → Gmail (free IMAP). Optional bridge script:
#   GMAIL_IMAP_USER=you@gmail.com
#   GMAIL_IMAP_PASS=xxxx-xxxx-xxxx-xxxx
#   MAIL_FORWARD_TOKEN=...   # only if using npm run mail:bridge
# GMAIL_IMAP_POLL_MS=30000
# GMAIL_IMAP_POLL_ENABLED=1
# GMAIL_IMAP_SECRET=change-me-for-password-encryption
