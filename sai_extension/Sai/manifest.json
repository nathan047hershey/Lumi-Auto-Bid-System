{
  "manifest_version": 3,
  "name": "Sai",
  "version": "2.2.2",
  "description": "Sai — your cute AI companion for job applications",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://boards.greenhouse.io/*",
        "*://job-boards.greenhouse.io/*",
        "*://*.greenhouse.io/*"
      ],
      "js": ["autofill/greenhouse_auto.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.myworkdayjobs.com/*"
      ],
      "js": ["autofill/workday_auto.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
